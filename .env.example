# ═══════════════════════════════════════════════════════
# THE DIET COKE INDEX — Environment Variables
# ═══════════════════════════════════════════════════════

# Kroger API (developer.kroger.com) — For live bulk pricing
# Register a free app to get these credentials
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Google Places API — For nearby store discovery
GOOGLE_PLACES_API_KEY=

# Upstash Redis (upstash.com) — For geohash-based response caching
# Free tier: 10k commands/day, perfect for this
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
